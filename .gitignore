.venv/
__pycache__/
.claude/settings.local.json

# Downloads: re-fetch with fetch_data.py. The big, stable ones (DEM, HydroRIVERS,
# geoBoundaries, Natural Earth, GLAD) stay out; the small OSM / Wikipedia / Wikidata
# snapshots are kept because those sources change and Overpass is often unavailable.
data/raw/*
!data/raw/osm_canals.json
!data/raw/osm_waterpipes.json
!data/raw/osm_places.json
!data/raw/osm_pumphouses.json
!data/raw/osm_reservoirs.json
!data/raw/wikipedia_dams.json
!data/raw/wikidata_dams.csv

# Generated by prepare_data.py / make_overlay.py / block.py
data/*.tif
data/*.png

# Viewer stills (view.py --snapshots); the block render is kept as a preview
out/*
!out/telangana_block.png

# Generated by build_web_data.py
web/tiles/
web/data/
