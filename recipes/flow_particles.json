{
  "version": 1,
  "type": "rasterarray",
  "sources": [
    { "uri": "mapbox://tileset-source/{username}/tg-flow-velocity" }
  ],
  "minzoom": 4,
  "maxzoom": 8,
  "layers": {
    "flow": {
      "tilesize": 512,
      "buffer": 1,
      "input_no_data_value": -9999,
      "source_rules": {
        "filter": [
          ["all", ["in", ["bandindex"], ["literal", [1]]]],
          ["all", ["in", ["bandindex"], ["literal", [2]]]]
        ],
        "name": ["literal", "flow"]
      }
    }
  }
}
